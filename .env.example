# Database (MySQL / MariaDB or PostgreSQL)
DATABASE_URL="mysql://username:strong_password@localhost:3306/it_hub"
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=it_hub

# Backend
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_random
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_32_characters_random
CORS_ORIGIN=https://yourdomain.com
NODE_ENV=production
PORT=3001

# Logging
LOG_LEVEL=info

# Cloudflare Analytics (Optional)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Private Cloud Storage
STORAGE_PATH=./storage/personal-drive
MAX_FILE_SIZE=5368709120

# AI Core / Gemini
GEMINI_API_KEY=your_gemini_api_key_here