{
  "name": "devkit-cli",
  "version": "1.0.0",
  "description": "A modern developer toolbox for the terminal and web interface.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "devkit": "./bin/devkit.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "start": "node ./bin/devkit.js"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "toolkit",
    "json",
    "jwt",
    "crypto",
    "hash",
    "network",
    "subnet",
    "system-info",
    "regex"
  ],
  "author": "Sabbil Abdillah Ferdyansyah",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.0.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "type": "module"
}
